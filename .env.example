# Copy to .env and fill in what you need. Nothing here is a real credential.

# Postgres. docker compose sets its own; this one is for `npm run dev`.
DATABASE_URL=postgresql://taskify:taskify@localhost:5432/taskify

# 1 = demo build: Clerk is swapped for local stand-ins and everyone shares
# one fictional user. For local use only, never deploy it. 0 = real Clerk.
TASKIFY_DEMO_AUTH=1

# Clerk (dashboard.clerk.com), required when TASKIFY_DEMO_AUTH=0.
# Enable Organizations in the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Stripe, optional. Without it the upgrade button shows an error.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Unsplash, optional. Without it the bundled covers in public/covers are used.
UNSPLASH_ACCESS_KEY=
